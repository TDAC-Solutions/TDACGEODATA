# PostgreSQL connection used by the app (copy to server/.env and adjust).
# The single real database is ags42_data (same as the AGS projects use).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ags42_data
DB_USER=postgres
DB_PASSWORD=postgres

# JWT signing secret — required; generate one per machine:
#   python -c "import secrets; print(secrets.token_hex(32))"
#JWT_SECRET_KEY=

# --- CORS -------------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser. Leave
# unset for local dev (defaults to http://localhost:5173).
# In production set it to the SPA's origin, or leave it unset when the API
# is served from the same origin behind a reverse proxy.
#CORS_ALLOW_ORIGINS=https://tdac.example.com

# --- SharePoint attachments -------------------------------------------------
# See ATTACHMENTS_SETUP.md for the full walkthrough.
#AZURE_CLIENT_ID=
#AZURE_CLIENT_SECRET=
#AZURE_TENANT_ID=
#SHAREPOINT_SITE_ID=
#SHAREPOINT_DRIVE_ID=

# Folder under the SharePoint drive root that owns every TDAC file, so
# project folders cannot collide with another app on the same site.
# Defaults to "TDAC". Decide this BEFORE the first upload: changing it
# afterwards leaves the existing tree where it is and starts a new one.
#SHAREPOINT_ROOT_FOLDER=TDAC

# End-to-end scripts (scripts/local_e2e*.sh) run against this same
# ags42_data database. The lab.* tables it writes start empty, so the
# e2e rows are easy to spot and delete afterwards.
