# TDAC frontend environment
#
# Copy to `.env` (or `.env.production`) and edit. Vite only exposes variables
# prefixed with VITE_, and only those reach the browser bundle. Never put a
# secret here: everything in this file is public once the app is built.
#
# ---------------------------------------------------------------------
# One switch to change the deployment mode
# ---------------------------------------------------------------------
# Set to "production" for a real deployment. This is the single flag that
# marks the build as a real one:
#
#   VITE_APP_ENV=production
#
# Leave it unset (or "development") for local work. IS_PRODUCTION in
# src/config.ts drives the dev-only affordances, and a misconfigured build
# is treated as production rather than development so it fails closed.
#
# ---------------------------------------------------------------------
# Where the API lives
# ---------------------------------------------------------------------
# Leave EMPTY when the SPA and the API are served from the same origin,
# which is what a single NGINX / ingress / ECS setup does. Requests then
# go to relative /api paths and the Vite dev proxy or the reverse proxy
# forwards them.
#
# Set it only when the API is on a different origin, for example a staging
# API against a production build:
#
#   VITE_API_BASE_URL=https://api.tdac.example
#
# It was previously hardcoded to http://127.0.0.1:8000 in three places.
# On a phone that address is the phone itself, so the app only worked on
# the developer's laptop. Do not put 127.0.0.1 back.
VITE_API_BASE_URL=

# ---------------------------------------------------------------------
# Scheme
# ---------------------------------------------------------------------
# Browsers only honour HTTP Range requests on media over HTTPS, so a plain
# http deployment serves videos that cannot be scrubbed. Set this to true
# when the app is served over https even if the browser cannot infer it
# (for example behind a proxy that terminates TLS).
VITE_FORCE_HTTPS=false

# ---------------------------------------------------------------------
# Local development backend
# ---------------------------------------------------------------------
# Only read by vite.config.js, never bundled into the app. Point the dev
# proxy at a backend on another host or port if needed.
VITE_DEV_API_TARGET=http://127.0.0.1:8000
